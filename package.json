{
  "name": "@flowcraft.systems/skills",
  "version": "2.0.0",
  "description": "FlowCraft methodology skills and agents for brownfield codebases — structured bug investigation, safe refactoring, and AI-first workflow discipline. Universal via SkillKit.",
  "keywords": [
    "ai-agents",
    "skills",
    "skillkit",
    "agent-skills",
    "flowcraft",
    "legacy-code",
    "brownfield",
    "technical-debt",
    "refactoring",
    "root-cause-analysis",
    "enterprise",
    "engineering-productivity",
    "cursor",
    "windsurf",
    "gemini-cli",
    "claude-code",
    "codex",
    "amazon-q"
  ],
  "homepage": "https://flowcraft.systems",
  "license": "MIT",
  "author": "FlowCraft Systems",
  "files": [
    "skills/",
    "agents/",
    "docs/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "validate": "skillkit validate --all --strict",
    "validate:agents": "skillkit agent validate",
    "validate:all": "skillkit validate --all --strict && skillkit agent validate",
    "test": "skillkit test --json",
    "publish": "skillkit publish .",
    "publish:submit": "skillkit publish submit",
    "prepare": "npm install -g skillkit"
  },
  "publishConfig": {
    "access": "public"
  }
}
